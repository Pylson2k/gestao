// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Seed configuration
// Run with: npm run db:seed

datasource db {
  provider = "postgresql"
}

enum FuncionarioStatus {
  ativo
  inativo
}

enum PresencaStatus {
  presente
  falta
  meio_periodo
}

enum ValeStatus {
  pendente
  pago
}

model User {
  id                String   @id @default(cuid())
  username          String   @unique
  name              String
  email             String   @unique
  password          String
  phone             String?
  company           String?
  mustChangePassword Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  quotes            Quote[]
  materialLists     MaterialList[]
  expenses          Expense[]
  auditLogs         AuditLog[]
  services          Service[]
  cashClosings      CashClosing[]
  payments          Payment[]

  @@map("users")
}

/// GETAO — Funcionários (modelo canônico do legado)
model Funcionario {
  id          Int              @id @default(autoincrement())
  nome        String
  /// Valor de diária (R$). No backend use Decimal para evitar float.
  valorDiaria Decimal?         @db.Decimal(10, 2)
  funcao      String?
  status      FuncionarioStatus @default(ativo)

  presencas   Presenca[]
  vales       Vale[]

  @@index([nome])
  @@index([status])
  @@map("funcionarios")
}

/// GETAO — Presença (uma linha por funcionário + data)
model Presenca {
  id            Int           @id @default(autoincrement())
  funcionarioId Int
  /// YYYY-MM-DD
  data          String
  horaEntrada   String?
  horaSaida     String?
  status        PresencaStatus @default(presente)

  funcionario   Funcionario  @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)

  @@unique([funcionarioId, data], map: "ux_presenca_funcionario_data")
  @@index([data], map: "ix_presenca_data")
  @@map("presenca")
}

/// GETAO — Vales (adiantamentos)
model Vale {
  id            Int        @id @default(autoincrement())
  funcionarioId Int
  /// Valor (R$)
  valor         Decimal    @db.Decimal(10, 2)
  /// YYYY-MM-DD (data do lançamento)
  data          String
  descricao     String?
  status        ValeStatus @default(pendente)

  funcionario   Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)

  @@index([data], map: "ix_vales_data")
  @@index([funcionarioId], map: "ix_vales_funcionario")
  @@map("vales")
}

model Client {
  id        String   @id @default(cuid())
  name      String
  phone     String
  address   String
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  quotes         Quote[]
  materialLists  MaterialList[]
  
  @@map("clients")
}

model Quote {
  id          String   @id @default(cuid())
  number      String   @unique
  userId      String
  clientId    String
  subtotal    Float
  discount    Float    @default(0)
  total       Float
  observations String?
  paymentTerms String? @db.Text
  conditions   String? @db.Text
  deadlines    String? @db.Text
  status      String   @default("draft") // draft, sent, approved, rejected, in_progress, completed, cancelled
  /// Incluído manualmente na tela Inadimplentes (não entra só por ter saldo devedor)
  inDelinquencyList Boolean @default(false)
  serviceStartedAt   DateTime?
  serviceCompletedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  services    ServiceItem[]
  materials   MaterialItem[]
  payments    Payment[]
  
  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([number])
  @@map("quotes")
}

model ServiceItem {
  id        String   @id @default(cuid())
  quoteId   String
  name      String
  quantity  Int
  unitPrice Float
  
  quote     Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  
  @@map("service_items")
}

model MaterialItem {
  id        String   @id @default(cuid())
  quoteId   String
  name      String
  quantity  Float
  unit      String   @default("unidade")
  unitPrice Float
  
  quote     Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  
  @@map("material_items")
}

/// Lista de materiais independente de orçamento (documento para o cliente comprar itens).
model MaterialList {
  id             String   @id @default(cuid())
  number         String   @unique
  userId         String
  clientId       String
  title          String?
  observations   String?  @db.Text
  /// Quando true, o PDF inclui colunas de valores e subtotal.
  includePrices  Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  client  Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  items   MaterialListItem[]

  @@index([userId, createdAt])
  @@map("material_lists")
}

model MaterialListItem {
  id             String   @id @default(cuid())
  materialListId String
  name           String
  quantity       Float
  unit           String   @default("unidade")
  unitPrice      Float    @default(0)

  materialList MaterialList @relation(fields: [materialListId], references: [id], onDelete: Cascade)

  @@map("material_list_items")
}

model CompanySettings {
  id                    String   @id @default(cuid())
  userId                String   @unique
  name                  String
  logo                  String?   @db.Text
  phone                 String
  email                 String
  address               String
  cnpj                  String?
  website               String?
  additionalInfo        String?   @db.Text
  companyCashPercentage Float    @default(10) // Porcentagem do lucro líquido para caixa da empresa (0 a 50)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  @@map("company_settings")
}

model Service {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?  @db.Text
  unitPrice   Float
  unit        String  @default("unidade") // unidade, hora, m², etc
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("services")
}

model CashClosing {
  id              String   @id @default(cuid())
  userId          String
  periodType      String   // semanal, quinzenal, mensal
  startDate       DateTime
  endDate         DateTime
  totalProfit     Float    // Lucro líquido total
  companyCash     Float    @default(0) // Valor destinado ao caixa da empresa
  gustavoProfit   Float    // Lucro do proprietário (após desconto do caixa da empresa e vales)
  totalRevenue    Float    // Receita total do período
  totalExpenses    Float    // Despesas total do período
  observations    String?  @db.Text
  createdAt       DateTime @default(now())
  
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId, endDate])
  @@map("cash_closings")
}

model Expense {
  id          String   @id @default(cuid())
  userId      String
  category    String   // material, combustivel, vale_funcionario, pagamento_funcionario, vale_gustavo, ...
  description String
  amount      Float
  date        DateTime
  observations String?   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("expenses")
}

model Payment {
  id          String   @id @default(cuid())
  quoteId     String
  userId      String
  amount      Float    // Valor do pagamento
  paymentDate DateTime // Data do pagamento
  paymentMethod String // dinheiro, pix, cartao_credito, cartao_debito, transferencia, boleto
  observations String? @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([quoteId])
  @@index([userId])
  @@index([paymentDate])
  @@map("payments")
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String
  action      String   // create_quote, update_quote, delete_quote, create_expense, update_expense, delete_expense, change_status, change_discount, change_total, create_payment, update_payment, delete_payment
  entityType  String   // quote, expense, payment
  entityId    String
  description String
  oldValue    String?  @db.Text  // JSON com valores antigos
  newValue    String?  @db.Text  // JSON com valores novos
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

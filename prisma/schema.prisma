// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Seed configuration
// Run with: npm run db:seed

datasource db {
  provider = "postgresql"
}

model User {
  id                String   @id @default(cuid())
  username          String   @unique
  name              String
  email             String   @unique
  password          String
  phone             String?
  company           String?
  mustChangePassword Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  quotes            Quote[]
  materialLists     MaterialList[]
  expenses          Expense[]
  auditLogs         AuditLog[]
  employees         Employee[]
  services          Service[]
  cashClosings      CashClosing[]
  payments          Payment[]
  workerAccounts    WorkerAccount[]
  ownedWorkAssignments WorkAssignment[] @relation("WorkAssignmentOwner")

  @@map("users")
}

model Client {
  id        String   @id @default(cuid())
  name      String
  phone     String
  address   String
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  quotes         Quote[]
  materialLists  MaterialList[]
  
  @@map("clients")
}

model Quote {
  id          String   @id @default(cuid())
  number      String   @unique
  userId      String
  clientId    String
  subtotal    Float
  discount    Float    @default(0)
  total       Float
  observations String?
  status      String   @default("draft") // draft, sent, approved, rejected, in_progress, completed, cancelled
  /// Incluído manualmente na tela Inadimplentes (não entra só por ter saldo devedor)
  inDelinquencyList Boolean @default(false)
  serviceStartedAt   DateTime?
  serviceCompletedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  services    ServiceItem[]
  materials   MaterialItem[]
  payments    Payment[]
  
  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([number])
  @@map("quotes")
}

model ServiceItem {
  id        String   @id @default(cuid())
  quoteId   String
  name      String
  quantity  Int
  unitPrice Float
  
  quote     Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  
  @@map("service_items")
}

model MaterialItem {
  id        String   @id @default(cuid())
  quoteId   String
  name      String
  quantity  Float
  unit      String   @default("unidade")
  unitPrice Float
  
  quote     Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  
  @@map("material_items")
}

/// Lista de materiais independente de orçamento (documento para o cliente comprar itens).
model MaterialList {
  id             String   @id @default(cuid())
  number         String   @unique
  userId         String
  clientId       String
  title          String?
  observations   String?  @db.Text
  /// Quando true, o PDF inclui colunas de valores e subtotal.
  includePrices  Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  client  Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  items   MaterialListItem[]

  @@index([userId, createdAt])
  @@map("material_lists")
}

model MaterialListItem {
  id             String   @id @default(cuid())
  materialListId String
  name           String
  quantity       Float
  unit           String   @default("unidade")
  unitPrice      Float    @default(0)

  materialList MaterialList @relation(fields: [materialListId], references: [id], onDelete: Cascade)

  @@map("material_list_items")
}

model CompanySettings {
  id                    String   @id @default(cuid())
  userId                String   @unique
  name                  String
  logo                  String?   @db.Text
  phone                 String
  email                 String
  address               String
  cnpj                  String?
  website               String?
  additionalInfo        String?   @db.Text
  companyCashPercentage Float    @default(10) // Porcentagem do lucro líquido para caixa da empresa (0 a 50)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  @@map("company_settings")
}

model Employee {
  id          String   @id @default(cuid())
  userId      String
  name        String
  cpf         String?
  phone       String?
  email       String?
  position    String?  // Cargo
  hireDate    DateTime?
  isActive    Boolean  @default(true)
  observations String?   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses    Expense[]
  workerAccount WorkerAccount?
  workAssignments WorkAssignment[]

  @@map("employees")
}

/// Conta do trabalhador (login no app /trabalhador).
model WorkerAccount {
  id            String   @id @default(cuid())
  employeeId    String   @unique
  loginUsername String   @unique
  passwordHash  String
  ownerUserId   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  employee Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  owner    User           @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  sessions WorkerSession[]

  @@index([ownerUserId])
  @@map("worker_accounts")
}

model WorkerSession {
  id        String   @id @default(cuid())
  token     String   @unique
  accountId String
  expiresAt DateTime
  createdAt DateTime @default(now())

  account WorkerAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("worker_sessions")
}

/// Vínculo obra/serviço: diária ou empreita (% ou etapas). Só conta em totais após ACTIVE + aprovações.
model WorkAssignment {
  id              String   @id @default(cuid())
  ownerUserId     String
  employeeId      String
  title           String
  mode            String   // DAILY | CONTRACT_PERCENT | CONTRACT_STEPS
  status          String   @default("DRAFT") // DRAFT | ACTIVE | CLOSED
  dailyRate       Float?
  contractTotal   Float?
  approvedPercent Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  owner    User       @relation("WorkAssignmentOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  employee Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  steps    ContractStep[]
  dayLogs  WorkDayLog[]
  submissions WorkerContractSubmission[]

  @@index([ownerUserId, employeeId])
  @@index([ownerUserId, status])
  @@map("work_assignments")
}

model ContractStep {
  id           String   @id @default(cuid())
  assignmentId String
  sortOrder    Int
  title        String
  amount       Float
  approvedDone Boolean  @default(false)
  createdAt    DateTime @default(now())

  assignment   WorkAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  submissions  WorkerContractSubmission[]

  @@unique([assignmentId, sortOrder])
  @@map("contract_steps")
}

model WorkDayLog {
  id           String    @id @default(cuid())
  assignmentId String
  workDate     DateTime  @db.Date
  clockInAt    DateTime
  clockOutAt   DateTime
  workerNote   String?   @db.Text
  status       String    @default("PENDING")
  dayUnits     Float?
  rejectReason String?   @db.Text
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())

  assignment WorkAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId, workDate])
  @@map("work_day_logs")
}

model WorkerContractSubmission {
  id              String    @id @default(cuid())
  assignmentId    String
  kind            String    // PERCENT | STEP_DONE
  proposedPercent Float?
  stepId          String?
  workerNote      String?   @db.Text
  status          String    @default("PENDING")
  rejectReason    String?   @db.Text
  reviewedAt      DateTime?
  createdAt       DateTime  @default(now())

  assignment WorkAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  step       ContractStep?  @relation(fields: [stepId], references: [id], onDelete: SetNull)

  @@index([assignmentId, status])
  @@map("worker_contract_submissions")
}

model Service {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?  @db.Text
  unitPrice   Float
  unit        String  @default("unidade") // unidade, hora, m², etc
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("services")
}

model CashClosing {
  id              String   @id @default(cuid())
  userId          String
  periodType      String   // semanal, quinzenal, mensal
  startDate       DateTime
  endDate         DateTime
  totalProfit     Float    // Lucro líquido total
  companyCash     Float    @default(0) // Valor destinado ao caixa da empresa
  gustavoProfit   Float    // Lucro do proprietário (após desconto do caixa da empresa e vales)
  totalRevenue    Float    // Receita total do período
  totalExpenses    Float    // Despesas total do período
  observations    String?  @db.Text
  createdAt       DateTime @default(now())
  
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId, endDate])
  @@map("cash_closings")
}

model Expense {
  id          String   @id @default(cuid())
  userId      String
  category    String   // material, combustivel, vale_funcionario, pagamento_funcionario, vale_gustavo, ...
  description String
  amount      Float
  date        DateTime
  observations String?   @db.Text
  employeeId  String?  // Relação opcional com funcionário
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  employee    Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  
  @@map("expenses")
}

model Payment {
  id          String   @id @default(cuid())
  quoteId     String
  userId      String
  amount      Float    // Valor do pagamento
  paymentDate DateTime // Data do pagamento
  paymentMethod String // dinheiro, pix, cartao_credito, cartao_debito, transferencia, boleto
  observations String? @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([quoteId])
  @@index([userId])
  @@index([paymentDate])
  @@map("payments")
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String
  action      String   // create_quote, update_quote, delete_quote, create_expense, update_expense, delete_expense, change_status, change_discount, change_total, create_payment, update_payment, delete_payment
  entityType  String   // quote, expense, payment
  entityId    String
  description String
  oldValue    String?  @db.Text  // JSON com valores antigos
  newValue    String?  @db.Text  // JSON com valores novos
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

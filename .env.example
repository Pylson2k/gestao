# Copie para .env ou .env.local e preencha com seu PostgreSQL (local, Neon, Supabase, RDS, etc.)
# Nunca commite .env com senhas reais.
#
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO?schema=public
DATABASE_URL="postgresql://usuario:senha@localhost:5432/servipro?schema=public"

# Obrigatório para usar POST /api/admin/reset-database e /api/admin/reset-passwords (?key=...)
# Em produção use um valor longo e aleatório; configure também no painel do host (ex.: Vercel).
ADMIN_OPERATIONS_SECRET="defina-um-segredo-longo-e-unico"

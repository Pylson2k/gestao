# =============================================================================
# O QUE FAZER (só precisa disso para o app funcionar com banco)
# =============================================================================
# 1) Copie este arquivo e renomeie a cópia para:  .env   (na mesma pasta)
# 2) No Neon (ou outro Postgres): copie a "Connection string" / URI completa
# 3) Cole abaixo em DATABASE_URL (uma linha só, entre aspas)
# 4) No terminal, na pasta do projeto, rode:  npm run db:primeiro-uso
#    (isso cria tabelas + usuário gustavo / senha gustavo123)
# 5) Depois: npm run dev
#
# Produção (Vercel): coloque DATABASE_URL e ADMIN_OPERATIONS_SECRET nas variáveis
# de ambiente do projeto — o deploy já aplica o schema automaticamente.
# =============================================================================

# Formato típico Neon:
# postgresql://USUARIO:SENHA@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://usuario:senha@localhost:5432/servipro?schema=public"

# Obrigatório para /reset e APIs admin (?key=...). Use um texto longo e aleatório.
ADMIN_OPERATIONS_SECRET="defina-um-segredo-longo-e-unico"
